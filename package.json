{
  "name": "ultimate-angular",
  "version": "0.0.0",
  "main": "electron/main.js",
  "description": "Ultimate Angular app",
  "author": "Tejas Bhatt <tejas.mvc@gmail.com>",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron:build": "ng build --base-href ./ && electron-builder",
    "electron:dev": "concurrently -k \"ng serve\" \"wait-on http://localhost:4200 && cross-env ELECTRON_DEV=true electron .\"",
    "electron:start": "npm run build:ng && electron .",
    "build:ng": "ng build --base-href ./",
    "dist:win32": "npm run build:ng && electron-builder --win --ia32",
    "dist:win64": "npm run build:ng && electron-builder --win --x64",
    "dist:win": "npm run build:ng && electron-builder --win --ia32 --x64",
    "dist:linux64": "npm run build:ng && electron-builder --linux --x64",
    "dist:linux-arm64": "npm run build:ng && electron-builder --linux --arm64",
    "dist:linux-armv7l": "npm run build:ng && electron-builder --linux --armv7l",
    "dist:mac-intel": "npm run build:ng && electron-builder --mac --x64",
    "dist:mac-silicon": "npm run build:ng && electron-builder --mac --arm64",
    "dist:mac-universal": "npm run build:ng && electron-builder --mac --universal"
  },
  "build": {
    "appId": "com.example.ultimateangular",
    "productName": "UltimateAngular",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Utility",
      "maintainer": "Your Name <you@example.com>"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    }
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.5.1"
  }
}
